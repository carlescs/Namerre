<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <WarningsAsErrors>$(WarningsAsErrors);MED001;MED002;MED003;MED005</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CMediator" Version="1.1.3" />
    <PackageReference Include="CMediator.Generators" Version="1.1.3" PrivateAssets="all" />
    <PackageReference Include="CMediato.CodeFixes" Version="1.1.3" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Namerre.Domain\Namerre.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Namerre.Application.UnitTests" />
  </ItemGroup>

</Project>
