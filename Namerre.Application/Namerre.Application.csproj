<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <WarningsAsErrors>$(WarningsAsErrors);MED001;MED002;MED003;MED005</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CMediator" Version="1.2.0" />
    <PackageReference Include="CMediator.Generators" Version="1.2.0" PrivateAssets="all" />
    <PackageReference Include="CMediato.CodeFixes" Version="1.1.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Namerre.Domain\Namerre.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Authentication\Resources\common-passwords.txt"
      LogicalName="Namerre.Application.Authentication.CommonPasswords" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Namerre.Application.UnitTests" />
  </ItemGroup>

</Project>
