<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="Github" value="https://nuget.pkg.github.com/carlescs/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="Github">
      <package pattern="CMediator" />
      <package pattern="CMediator.*" />
      <package pattern="CMediato.CodeFixes" />
    </packageSource>
  </packageSourceMapping>
</configuration>
