  "detect": [
    {
      "name": "subtitle, nfo and artwork follow their video",
      "files": [
        "A/Movie.mkv",
        "A/Movie.en.srt",
        "A/Movie.nfo",
        "A/Movie-poster.jpg",
        "A/Other.txt"
      ],
      "expected": {
        "A/Movie.en.srt": "A/Movie.mkv",
        "A/Movie.nfo": "A/Movie.mkv",
        "A/Movie-poster.jpg": "A/Movie.mkv"
      }
    },
    {
      "name": "fanart and thumb",
      "files": ["Movie.mkv", "Movie-fanart.jpg", "Movie-thumb.png"],
      "expected": {
        "Movie-fanart.jpg": "Movie.mkv",
        "Movie-thumb.png": "Movie.mkv"
      }
    },
    {
      "name": "different folders never pair",
      "files": ["A/Movie.mkv", "B/Movie.srt"],
      "expected": {}
    },
    {
      "name": "no video, no companions",
      "files": ["Movie.srt", "Movie.nfo"],
      "expected": {}
    },
    {
      "name": "videos are never companions",
      "files": ["Movie.mkv", "Movie.en.mkv"],
      "expected": {}
    },
    {
      "name": "longest video stem wins",
      "files": ["Movie.mkv", "Movie.en.mkv", "Movie.en.srt"],
      "expected": {
        "Movie.en.srt": "Movie.en.mkv"
      }
    },
    {
      "name": "each video keeps its own companions",
      "files": [
        "Show S01E01.mkv",
        "Show S01E02.mkv",
        "Show S01E01.srt",
        "Show S01E02.en.srt",
        "Show S01E02.nfo"
      ],
      "expected": {
        "Show S01E01.srt": "Show S01E01.mkv",
        "Show S01E02.en.srt": "Show S01E02.mkv",
        "Show S01E02.nfo": "Show S01E02.mkv"
      }
    },
    {
      "name": "a stem followed by a space is not a companion",
      "files": ["Movie.mkv", "Movie 2.srt", "Movie2-poster.jpg"],
      "expected": {}
    },
    {
      "name": "companion of an uppercase extension video",
      "files": ["Movie.MKV", "Movie.srt"],
      "expected": {
        "Movie.srt": "Movie.MKV"
      }
    },
    {
      "name": "nested folders are matched exactly",
      "files": ["A/B/Movie.mkv", "A/Movie.srt", "A/B/Movie.srt"],
      "expected": {
        "A/B/Movie.srt": "A/B/Movie.mkv"
      }
    },
    {
      "name": "empty request",
      "files": [],
      "expected": {}
    }
  ]
}
